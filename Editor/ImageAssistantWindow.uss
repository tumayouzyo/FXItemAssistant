.assistant-scroll { flex-grow: 1; }
.assistant-scroll > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { flex-grow: 1; }
.assistant-root { flex-grow: 1; padding: 8px; }
.row { flex-direction: row; align-items: center; margin-bottom: 5px; }
.grow { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.workspace { flex-grow: 1; }
.preview-panel { flex-grow: 1; min-width: 200px; }
.preview { flex-grow: 1; height: 260px; min-height: 180px; background-color: rgb(38, 38, 38); }
.controls { flex-shrink: 0; }
.controls .unity-base-field__label { min-width: 120px; }
.hint { font-size: 11px; white-space: normal; margin-top: 4px; margin-bottom: 4px; }
.section { margin-top: 6px; margin-bottom: 6px; }
.save-button { height: 32px; flex-grow: 2; }
.folder-button { height: 32px; flex-grow: 1; }
.path { white-space: normal; }
.settings { height: 140px; flex-shrink: 0; }
.wrap { flex-wrap: wrap; }
.wrap > .grow { flex-basis: 220px; }
.title { -unity-font-style: bold; margin-bottom: 6px; }
#targetField { flex-basis: 250px; }
#targetField .unity-base-field__label { min-width: 95px; }
#status { flex-shrink: 0; }
.settings-window .settings { height: auto; }

.settings-root { flex-grow: 1; padding: 14px; min-height: 0; }
.settings-content { flex-grow: 1; flex-basis: 0; min-height: 0; }
.settings-heading { -unity-font-style: bold; margin-bottom: 8px; }
.settings-language-buttons { flex-direction: row; margin-bottom: 4px; }
.settings-language-buttons > .unity-button { min-width: 100px; margin-right: 8px; }
.settings-description { white-space: normal; margin-top: 5px; margin-bottom: 8px; flex-shrink: 0; }
.settings-footer { flex-shrink: 0; margin-top: 10px; padding-top: 10px; border-top-width: 1px; border-top-color: rgba(128, 128, 128, 0.5); }
.footer-credit { white-space: normal; margin-bottom: 8px; }
.footer-links { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.footer-links > .unity-button { margin-right: 8px; margin-bottom: 4px; }
.footer-details { flex-shrink: 0; margin-top: 4px; }
.footer-details-scroll { height: 160px; flex-shrink: 0; margin-top: 6px; }
.settings-actions { flex-direction: row; flex-shrink: 0; margin-top: 14px; }
.settings-actions > .unity-button { min-width: 100px; margin-left: 8px; }
.settings-spacer { flex-grow: 1; }
